# OneTag AI site key for the Ask AI box.
# Get a free key: https://onetagai.com/?ref=nextjs-ai-docs#get-key
#   curl -X POST https://onetagai.com/api/signup -H "Content-Type: application/json" -d '{"email":"you@example.com"}'
# The key is public by design: it ends up in the built HTML, like an analytics ID.
# Free plan: 1,000,000 tokens, one time, no monthly reset, hard cap, no bill can appear.
# Without a key the demo key is used, which only answers on localhost.
NEXT_PUBLIC_ONETAG_KEY=

# Public address of the deployed site, used for absolute links in llms.txt.
# On Vercel this is filled in for you from the production domain.
NEXT_PUBLIC_SITE_URL=
